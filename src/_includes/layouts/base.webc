<!doctype html>
<html :lang="site.locale.replace('_', '-')">
  <head>
    <!-- webc:is, not <site-head>: the HTML parser relocates unknown elements
         out of <head>, so the component is mounted on a tag that belongs there. -->
    <meta webc:is="site-head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-brand focus:px-4 focus:py-2 focus:text-sm focus:text-brand-fg"
      >Skip to content</a
    >
    <site-header></site-header>
    <main id="main" class="flex-1" @html="content"></main>
    <site-footer></site-footer>
    <lightbox-dialog></lightbox-dialog>
  </body>
</html>
