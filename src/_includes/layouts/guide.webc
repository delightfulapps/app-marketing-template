---
layout: base.webc
ogType: article
ogImage: /assets/og/guides.png
---

<article class="section">
  <div class="container-prose">
    <p class="text-sm text-muted">
      <a href="/guides/" class="link">Guides</a>
    </p>

    <h1 class="mt-4 text-3xl font-semibold sm:text-4xl" @text="title"></h1>

    <!-- `updated`, not `date`: a guide is revised rather than published, and
         freshness is the signal that matters for a how-to. Both are undefined
         unless the front matter sets them — Eleventy's automatic date lives on
         page.date, not here — so this line stays off until there is something
         true to say. -->
    <p webc:if="updated" class="mt-3 text-sm text-muted">
      Last updated
      <time
        :datetime="new Date(updated).toISOString().slice(0, 10)"
        @text="new Date(updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })"
      ></time>
    </p>

    <!-- @html="content", not <slot>: an Eleventy WebC layout receives the page
         body as `content`, and a <slot> here silently renders nothing. -->
    <div class="prose prose-page mt-8" @html="content"></div>
  </div>
</article>
