---
layout: base.webc
ogType: article
ogImage: /assets/og/blog.png
---

<article class="section">
  <div class="container-prose">
    <p class="text-sm text-muted">
      <a href="/blog/" class="link">Blog</a>
    </p>

    <h1 class="mt-4 text-3xl font-semibold sm:text-4xl" @text="title"></h1>

    <p class="mt-3 text-sm text-muted">
      <time
        webc:if="date"
        :datetime="new Date(date).toISOString().slice(0, 10)"
        @text="new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })"
      ></time>
    </p>

    <!-- @html="content", not <slot>: an Eleventy WebC layout receives the page
         body as `content`, and a <slot> here silently renders nothing. -->
    <div class="prose prose-page mt-8" @html="content"></div>
  </div>
</article>
