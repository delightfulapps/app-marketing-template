<section class="section border-t border-border" id="download">
  <div class="container-page">
    <div class="card flex flex-col items-center px-6 py-12 text-center">
      <h2 class="section-heading" @text="`Get ${$data.site.name}`"></h2>
      <p class="mt-3 max-w-md text-muted" @text="$data.site.pricingNote"></p>

      <div class="mt-8">
        <store-badges></store-badges>
      </div>

      <p class="mt-6 text-sm text-muted" @text="$data.site.operatingSystems"></p>
    </div>
  </div>
</section>
