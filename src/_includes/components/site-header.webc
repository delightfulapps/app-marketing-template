<header class="sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight hover:opacity-80"
    >
      <img
        src="/assets/icon.png"
        alt=""
        width="28"
        height="28"
        class="rounded-[6px]"
        eleventy:ignore
      />
      <!-- The icon carries the brand on narrow screens; a long app name would
           otherwise wrap and push the nav off the viewport. -->
      <span class="hidden sm:inline" @text="$data.site.name"></span>
      <span class="sr-only sm:hidden" @text="$data.site.name"></span>
    </a>

    <!-- Entries come from `eleventyNavigation` front matter on each page, via
         the `nav` collection in eleventy.config.js. -->
    <nav
      :aria-label="`${$data.site.name} primary`"
      class="-mx-1 flex items-center gap-0.5 overflow-x-auto sm:gap-1"
    >
      <a
        webc:for="entry of $data.collections.nav"
        :href="entry.url"
        class="whitespace-nowrap rounded-full px-2.5 py-1.5 text-sm text-muted transition-colors hover:bg-brand/5 hover:text-fg sm:px-3"
        :class="$data.page.url === entry.url ? 'text-fg font-medium' : ''"
        :aria-current="$data.page.url === entry.url ? 'page' : false"
        @text="entry.title"
      ></a>
    </nav>
  </div>
</header>
