<script webc:setup>
  // Pure functions — see the note in site-head.webc about webc:setup.
  function facts(site) {
    return [
      ["App", site.name],
      ["Publisher", site.publisher],
      // appCategory is the schema.org token, which is not English — show
      // appCategoryLabel to readers and keep the token for the structured data.
      ["Category", site.appCategoryLabel || site.appCategory],
      ["Platforms", site.operatingSystems],
      ["Pricing", site.pricingNote],
      ["Website", site.url],
      ["Press contact", site.pressEmail],
    ];
  }

  // Same dedupe as app-store-badge.webc: a universal purchase points both keys
  // at one product page, and listing it twice would just look like an error.
  function stores(site) {
    return [
      ["App Store", site.appStoreUrl],
      ["Mac App Store", site.macAppStoreUrl],
    ].filter(
      ([label, url]) =>
        url &&
        !url.startsWith("TODO") &&
        !(label === "Mac App Store" && url === site.appStoreUrl),
    );
  }
</script>

<dl class="grid gap-x-8 gap-y-3 sm:grid-cols-[10rem_1fr]">
  <template webc:for="row of facts($data.site)" webc:nokeep>
    <dt class="text-sm font-medium text-muted" @text="row[0]"></dt>
    <dd @text="row[1]"></dd>
  </template>

  <template webc:for="store of stores($data.site)" webc:nokeep>
    <dt class="text-sm font-medium text-muted" @text="store[0]"></dt>
    <dd><a :href="store[1]" class="link break-all" @text="store[1]"></a></dd>
  </template>
</dl>
