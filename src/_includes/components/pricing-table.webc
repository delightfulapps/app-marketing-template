<!-- Tiers come from src/content/pricing/ — one markdown file each. -->
<section webc:if="$data.collections.pricing.length" class="section">
  <div class="container-page">
    <ul
      class="mx-auto grid items-start gap-6 sm:grid-cols-2"
      :class="$data.collections.pricing.length > 2 ? 'max-w-5xl lg:grid-cols-3' : 'max-w-3xl'"
    >
      <li
        webc:for="tier of $data.collections.pricing"
        class="card flex h-full flex-col p-7"
        :class="tier.data.featured ? 'ring-2 ring-brand' : ''"
      >
        <p
          webc:if="tier.data.featured"
          class="mb-3 w-fit rounded-full bg-brand/10 px-2.5 py-0.5 text-xs font-medium text-brand"
        >
          Most popular
        </p>

        <h2 class="text-lg font-semibold" @text="tier.data.title"></h2>

        <p class="mt-3 flex items-baseline gap-1.5">
          <span class="text-3xl font-semibold" @text="tier.data.price"></span>
          <span class="text-sm text-muted" @text="tier.data.period"></span>
        </p>

        <!-- Optional. Where an annual tier states its saving against monthly. -->
        <p
          webc:if="tier.data.note"
          class="mt-2 text-sm font-medium text-brand"
          @text="tier.data.note"
        ></p>

        <div
          class="prose prose-page prose-sm mt-5 flex-1 text-muted"
          @html="tier.content"
        ></div>
      </li>
    </ul>

    <!-- One badge, not one per tier: every plan is the same App Store product,
         so repeating the same link in each card would read as a mistake. Going
         through store-badges rather than app-store-badge also keeps the
         "set appStoreUrl" placeholder before the store URLs are filled in. -->
    <div class="mt-12 flex flex-col items-center gap-4">
      <store-badges></store-badges>
      <p class="max-w-md text-center text-sm text-muted">
        Every plan is the same free download — subscriptions are managed in the
        App Store.
      </p>
    </div>
  </div>
</section>
