<script webc:setup>
  // IMPORTANT: `webc:setup` runs once per component for the whole build, not
  // once per page — a `const` here would freeze the first page's values into
  // every page. So it holds pure functions only, and everything page-specific
  // is read from $data at the point of use. Same rule in every component here.
  // Relative luminance, per WCAG. Accepts #rgb and #rrggbb(aa); alpha is
  // ignored because the brand colour is only ever painted on an opaque surface.
  function luminance(hex) {
    const h = String(hex).replace("#", "");
    const full = h.length < 6 ? h.slice(0, 3).replace(/./g, (c) => c + c) : h;
    const channel = (i) => {
      const v = parseInt(full.slice(i * 2, i * 2 + 2), 16) / 255;
      return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
    };
    return 0.2126 * channel(0) + 0.7152 * channel(1) + 0.0722 * channel(2);
  }

  // What to print on top of the brand colour. Derived rather than configured:
  // a site whose brand is light needs dark button text, and having to remember
  // to flip a second knob is how that gets shipped wrong.
  //
  // White and near-black give equal contrast against a background of luminance
  // ~0.19 — solve 1.05/(L+0.05) = (L+0.05)/0.055 — so that is the crossover.
  // Eyeballing a higher threshold keeps white text well past the point where
  // dark text is the more legible of the two.
  function onBrand(hex) {
    return luminance(hex) > 0.19 ? "#0b0b0e" : "#ffffff";
  }

  // Dark mode gets its own brand colour when `themeColorDark` is set. Sites
  // whose brand sits mid-range look fine either way and can leave it unset;
  // a very dark or very light brand needs it, or it vanishes into one of the
  // two backgrounds.
  function brandTokens(site) {
    const dark = site.themeColorDark || site.themeColor;
    return (
      `:root{--brand:${site.themeColor};--brand-fg:${onBrand(site.themeColor)};` +
      `--bg:${site.backgroundColor}}` +
      `@media(prefers-color-scheme:dark){:root{--brand:${dark};` +
      `--brand-fg:${onBrand(dark)};--bg:${site.backgroundColorDark}}}`
    );
  }
</script>

<template webc:nokeep>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />

  <title @text="$data.seo.title"></title>
  <meta name="description" :content="$data.seo.description" />
  <link rel="canonical" :href="$data.seo.canonical" />
  <meta webc:if="$data.seo.noindex" name="robots" content="noindex,follow" />

  <meta property="og:type" :content="$data.seo.type" />
  <meta property="og:site_name" :content="$data.site.name" />
  <meta property="og:locale" :content="$data.site.locale" />
  <meta property="og:title" :content="$data.seo.title" />
  <meta property="og:description" :content="$data.seo.description" />
  <meta property="og:url" :content="$data.seo.canonical" />
  <meta property="og:image" :content="$data.seo.image" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" :content="$data.seo.imageAlt" />
  <meta
    webc:if="$data.updated"
    property="og:updated_time"
    :content="new Date($data.updated).toISOString()"
  />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" :content="$data.seo.title" />
  <meta name="twitter:description" :content="$data.seo.description" />
  <meta name="twitter:image" :content="$data.seo.image" />
  <meta name="twitter:image:alt" :content="$data.seo.imageAlt" />

  <!-- Smart app banner. Suppressed until site.js carries a real App Store id. -->
  <meta
    webc:if="!$data.site.appStoreId.startsWith('TODO')"
    name="apple-itunes-app"
    :content="`app-id=${$data.site.appStoreId}`"
  />

  <meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    :content="$data.site.backgroundColor"
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    :content="$data.site.backgroundColorDark"
  />

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link
    rel="icon"
    href="/assets/icons/icon-192.png"
    type="image/png"
    sizes="192x192"
  />
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <!-- Only advertise a feed that exists — see src/_data/sections.js. -->
  <link
    webc:if="$data.sections.blog"
    rel="alternate"
    type="application/atom+xml"
    :title="`${$data.site.name} blog`"
    href="/blog.xml"
  />
  <link
    webc:if="$data.sections.changelog"
    rel="alternate"
    type="application/atom+xml"
    :title="`${$data.site.name} release notes`"
    href="/changelog.xml"
  />

  <!-- webc:keep: WebC would otherwise pull this into its own asset bundle.
       The stylesheet is built by Tailwind and served as a plain file. -->
  <link rel="stylesheet" href="/assets/css/site.css" webc:keep />

  <!-- Brand tokens straight from src/_data/site.js. Unlayered and after the
       stylesheet, so these beat the fallbacks in tailwind.css. This is why no
       brand colour is ever hardcoded in CSS. -->
  <style webc:keep @html="brandTokens($data.site)"></style>

  <json-ld webc:if="$data.page.url === '/'"></json-ld>
</template>
