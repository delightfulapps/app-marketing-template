---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ site.name | dump | safe }},
  "short_name": {{ site.name | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "start_url": "/",
  "display": "browser",
  "theme_color": {{ site.themeColor | dump | safe }},
  "background_color": {{ site.backgroundColor | dump | safe }},
  "icons": [
    { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
